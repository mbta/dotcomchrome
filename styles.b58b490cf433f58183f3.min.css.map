@media (min-width: 800px) {
  .mbta__dotcomchrome__container {
    padding-left: 0;
    padding-right: 0;
  }
}

.mbta__dotcomchrome__body-wrapper {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  height: 100%;
  max-width: 100%;
  overflow: visible;
  width: 100%;
}
@media print {
  .mbta__dotcomchrome__body-wrapper {
    display: block;
  }
}
.mbta__dotcomchrome__body-wrapper.mbta__dotcomchrome__modal-open {
  overflow: hidden;
}

@media print {
  .mbta__dotcomchrome__header {
    display: none;
  }
}

.mbta__dotcomchrome__alert-announcement__container,
.mbta__dotcomchrome__header,
.mbta__dotcomchrome__schedule__header,
.mbta__dotcomchrome__breadcrumb-container,
.mbta__dotcomchrome__l-footer,
.mbta__dotcomchrome__m-secondary-nav {
  flex: 0 0 auto;
  max-width: 100%;
  width: 100%;
}

.mbta__dotcomchrome__alert-announcement__container,
.mbta__dotcomchrome__header,
.mbta__dotcomchrome__breadcrumb-container {
  align-self: flex-start;
}

.mbta__dotcomchrome__l-footer {
  align-self: flex-end;
}

.mbta__dotcomchrome__font-white {
  font-family: "Inter", "Helvetica Neue", Helvetica, Arial, sans-serif;
