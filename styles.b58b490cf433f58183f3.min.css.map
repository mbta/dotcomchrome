    margin-bottom: 4px;
  }
}
.mbta__dotcomchrome__m-footer__links a:hover {
  color: #5da9e8;
  -webkit-text-decoration: underline;
  text-decoration: underline;
}
.mbta__dotcomchrome__m-footer__links a:active {
  color: #165c96;
  -webkit-text-decoration: underline;
  text-decoration: underline;
