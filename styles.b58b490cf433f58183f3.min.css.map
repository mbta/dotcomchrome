@keyframes mbta__dotcomchrome__fa-flip {
  50% {
    transform: rotate3d(var(--fa-flip-x, 0), var(--fa-flip-y, 1), var(--fa-flip-z, 0), var(--fa-flip-angle, -180deg));
  }
}
@keyframes mbta__dotcomchrome__fa-shake {
  0% {
    transform: rotate(-15deg);
  }
  4% {
    transform: rotate(15deg);
  }
  8%, 24% {
    transform: rotate(-18deg);
  }
  12%, 28% {
    transform: rotate(18deg);
  }
  16% {
    transform: rotate(-22deg);
  }
  20% {
    transform: rotate(22deg);
  }
  32% {
    transform: rotate(-12deg);
  }
  36% {
    transform: rotate(12deg);
  }
  40%, 100% {
    transform: rotate(0deg);
  }
}
@keyframes mbta__dotcomchrome__fa-spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}
.mbta__dotcomchrome__fa-rotate-90 {
  transform: rotate(90deg);
}

.mbta__dotcomchrome__fa-rotate-180 {
  transform: rotate(180deg);
}

.mbta__dotcomchrome__fa-rotate-270 {
  transform: rotate(270deg);
}

.mbta__dotcomchrome__fa-flip-horizontal {
  transform: scale(-1, 1);
}

.mbta__dotcomchrome__fa-flip-vertical {
  transform: scale(1, -1);
}

.mbta__dotcomchrome__fa-flip-both,
.mbta__dotcomchrome__fa-flip-horizontal.mbta__dotcomchrome__fa-flip-vertical {
  transform: scale(-1, -1);
}

.mbta__dotcomchrome__fa-rotate-by {
  transform: rotate(var(--fa-rotate-angle, 0));
}

.mbta__dotcomchrome__fa-stack {
  display: inline-block;
  height: 2em;
  line-height: 2em;
  position: relative;
  vertical-align: middle;
  width: 2.5em;
}

.mbta__dotcomchrome__fa-stack-1x,
.mbta__dotcomchrome__fa-stack-2x {
  left: 0;
  position: absolute;
  text-align: center;
  width: 100%;
  z-index: var(--fa-stack-z-index, auto);
}

.mbta__dotcomchrome__fa-stack-1x {
  line-height: inherit;
}

.mbta__dotcomchrome__fa-stack-2x {
  font-size: 2em;
}

.mbta__dotcomchrome__fa-inverse {
  color: var(--fa-inverse, #fff);
}

