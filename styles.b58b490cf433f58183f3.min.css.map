.mbta__dotcomchrome__h2 + :where(.mbta__dotcomchrome__m-footer__group-title, h3){
  margin-top: -.125em;
}

.mbta__dotcomchrome__m-footer__group-title{
  font-family: var(--font-family-heading);
  font-weight: 700;
  line-height: 1.275em;
  margin-top: 1.075em;
  margin-bottom: .375em;
  font-size: 1.3125rem;
}

.mbta__dotcomchrome__m-footer__group-title + :where(p, ul, ol){
  margin-top: -.25em;
}

.mbta__dotcomchrome__m-footer__group-title + div > :where(p, ul, ol):first-child{
  margin-top: -.25em;
}

.mbta__dotcomchrome__m-footer__group-title + div > div > :where(p, ul, ol):first-child{
  margin-top: -.25em;
}

.mbta__dotcomchrome__m-footer__group-title + p > img:first-child,.mbta__dotcomchrome__m-footer__group-title + p > a:first-child > img:first-child{
  margin-top: -.25em;
}

@media (min-width: 544px){
  .mbta__dotcomchrome__m-footer__group-title + .mbta__dotcomchrome__c-media--half + p{
    margin-top: -.25em;
  }
  .mbta__dotcomchrome__m-footer__group-title + .mbta__dotcomchrome__c-media--half .mbta__dotcomchrome__c-media__content{
    margin-top: -.25em;
  }
}

@media (max-width: 544px){
  .mbta__dotcomchrome__m-footer__group-title + div > div ~ div > :where(p, ul, ol):first-child{
    margin-top: 0;
  }
}

.mbta__dotcomchrome__m-footer__group-title + :where(.mbta__dotcomchrome__h4, h4){
  margin-top: -.125em;
}

